{
  "version": "2.0.0",
  "project_name": "elite-agent-bootstrap",
  "description": "Registro oficial y catálogo de gobernanza de agentes de IA para Elite Agent Bootstrap v2",
  "governance_source": ".specify/memory/constitution.md",
  "default_decision_provider": "deterministic",
  "agents": [
    {
      "id": "orchestrator",
      "name": "Orquestador Principal",
      "description": "Coordina el flujo de trabajo SDD, asigna tareas entre agentes y gestiona el estado global del proyecto.",
      "role": "orchestrator",
      "capabilities": [
        "routing",
        "state-management",
        "task-dispatching",
        "phase-coordination"
      ],
      "tools": [
        "git",
        "speckit-cli"
      ],
      "skills": [
        "speckit-sdd"
      ],
      "inputs": [
        "user_request",
        "project_status"
      ],
      "outputs": [
        "phase_plan",
        "handoff_dispatch"
      ],
      "allowed_files": [
        ".agents/**",
        "PROJECT_LOG.md",
        "README.md"
      ],
      "forbidden_files": [
        "src/**",
        "app/**",
        ".specify/memory/constitution.md"
      ],
      "dependencies": [],
      "risk_level": "medium",
      "requires_human_approval": false,
      "can_delegate": true,
      "can_modify_code": false,
      "can_modify_specs": true,
      "can_modify_governance": false,
      "can_commit": true,
      "can_merge": false
    },
    {
      "id": "spec-agent",
      "name": "Especialista en Especificaciones (SpecAgent)",
      "description": "Redacta, audita y mantiene especificaciones funcionales (spec.md), planes técnicos (plan.md) y listas de tareas (tasks.md).",
      "role": "spec-agent",
      "capabilities": [
        "requirements-analysis",
        "bdd-specifications",
        "architecture-planning",
        "task-breakdown"
      ],
      "tools": [
        "speckit-cli",
        "context7-mcp"
      ],
      "skills": [
        "speckit-sdd"
      ],
      "inputs": [
        "requirements",
        "clarifications"
      ],
      "outputs": [
        "spec.md",
        "plan.md",
        "tasks.md"
      ],
      "allowed_files": [
        "specs/**",
        ".specify/templates/**"
      ],
      "forbidden_files": [
        "src/**",
        "app/**",
        "tests/**",
        ".specify/memory/constitution.md"
      ],
      "dependencies": [
        "orchestrator"
      ],
      "risk_level": "low",
      "requires_human_approval": false,
      "can_delegate": false,
      "can_modify_code": false,
      "can_modify_specs": true,
      "can_modify_governance": false,
      "can_commit": true,
      "can_merge": false
    },
    {
      "id": "implementer",
      "name": "Ingeniero de Implementación (Implementer)",
      "description": "Desarrolla código de producción guiado por tareas específicas en tasks.md siguiendo metodología TDD.",
      "role": "implementer",
      "capabilities": [
        "code-generation",
        "refactoring",
        "tdd-cycle",
        "dependency-wiring"
      ],
      "tools": [
        "terminal",
        "editor-tools",
        "linter"
      ],
      "skills": [
        "speckit-sdd"
      ],
      "inputs": [
        "tasks.md",
        "plan.md"
      ],
      "outputs": [
        "source_code",
        "implementation_evidence"
      ],
      "allowed_files": [
        "src/**",
        "app/**",
        "lib/**",
        "bin/**"
      ],
      "forbidden_files": [
        ".specify/memory/constitution.md",
        ".github/workflows/**",
        "specs/**"
      ],
      "dependencies": [
        "spec-agent"
      ],
      "risk_level": "medium",
      "requires_human_approval": false,
      "can_delegate": false,
      "can_modify_code": true,
      "can_modify_specs": false,
      "can_modify_governance": false,
      "can_commit": true,
      "can_merge": false
    },
    {
      "id": "tester",
      "name": "Ingeniero de Pruebas y QA (TestingAgent)",
      "description": "Diseña y ejecuta pruebas unitarias, de integración y end-to-end, asegurando la cobertura y el ciclo RED-GREEN.",
      "role": "tester",
      "capabilities": [
        "unit-testing",
        "integration-testing",
        "test-coverage",
        "regression-testing"
      ],
      "tools": [
        "vitest",
        "jest",
        "pytest",
        "playwright"
      ],
      "skills": [
        "speckit-sdd"
      ],
      "inputs": [
        "spec.md",
        "source_code"
      ],
      "outputs": [
        "test_files",
        "coverage_report"
      ],
      "allowed_files": [
        "tests/**",
        "spec/**",
        "**/*.test.*",
        "**/*.spec.*"
      ],
      "forbidden_files": [
        "src/**",
        ".specify/memory/constitution.md",
        ".github/workflows/**"
      ],
      "dependencies": [
        "implementer"
      ],
      "risk_level": "low",
      "requires_human_approval": false,
      "can_delegate": false,
      "can_modify_code": true,
      "can_modify_specs": false,
      "can_modify_governance": false,
      "can_commit": true,
      "can_merge": false
    },
    {
      "id": "security-agent",
      "name": "Auditor de Seguridad y Políticas (SecurityAgent)",
      "description": "Audita el código contra vulnerabilidades OWASP para agentes, inyección de prompts, exposición de secretos y licencias.",
      "role": "security-agent",
      "capabilities": [
        "owasp-audit",
        "secret-scanning",
        "dependency-vulnerability-check",
        "least-privilege-audit"
      ],
      "tools": [
        "git",
        "npm-audit",
        "secret-scanner"
      ],
      "skills": [
        "speckit-sdd"
      ],
      "inputs": [
        "source_code",
        "pull_request"
      ],
      "outputs": [
        "security_audit_report"
      ],
      "allowed_files": [
        ".evidence/**",
        "docs/security/**"
      ],
      "forbidden_files": [
        "src/**",
        "package.json",
        ".specify/memory/constitution.md"
      ],
      "dependencies": [
        "implementer"
      ],
      "risk_level": "low",
      "requires_human_approval": false,
      "can_delegate": false,
      "can_modify_code": false,
      "can_modify_specs": false,
      "can_modify_governance": false,
      "can_commit": false,
      "can_merge": false
    },
    {
      "id": "reviewer",
      "name": "Revisor Técnico y Puerta de Calidad (ReviewerAgent)",
      "description": "Evalúa de forma independiente las soluciones generadas contra la especificación y los criterios de aceptación antes del cierre de feature.",
      "role": "reviewer",
      "capabilities": [
        "code-review",
        "acceptance-criteria-verification",
        "compliance-check"
      ],
      "tools": [
        "git",
        "gh-cli"
      ],
      "skills": [
        "speckit-sdd"
      ],
      "inputs": [
        "spec.md",
        "pull_request",
        "evidence"
      ],
      "outputs": [
        "review_verdict"
      ],
      "allowed_files": [
        ".evidence/**",
        "specs/**"
      ],
      "forbidden_files": [
        "src/**",
        ".specify/memory/constitution.md"
      ],
      "dependencies": [
        "tester",
        "security-agent"
      ],
      "risk_level": "medium",
      "requires_human_approval": true,
      "can_delegate": false,
      "can_modify_code": false,
      "can_modify_specs": false,
      "can_modify_governance": false,
      "can_commit": false,
      "can_merge": false
    },
    {
      "id": "optimization-agent",
      "name": "Especialista en Optimización y Rendimiento (OptimizationAgent)",
      "description": "Analiza el tamaño de los artefactos de compilación, latencias, cuellos de botella y eficiencia de memoria.",
      "role": "optimization-agent",
      "capabilities": [
        "bundle-analysis",
        "performance-profiling",
        "memory-leak-detection"
      ],
      "tools": [
        "bundle-analyzer",
        "lighthouse"
      ],
      "skills": [
        "speckit-sdd"
      ],
      "inputs": [
        "build_artifacts"
      ],
      "outputs": [
        "performance_audit_report"
      ],
      "allowed_files": [
        ".evidence/**",
        "docs/performance/**"
      ],
      "forbidden_files": [
        "src/**",
        ".specify/memory/constitution.md"
      ],
      "dependencies": [
        "implementer"
      ],
      "risk_level": "low",
      "requires_human_approval": false,
      "can_delegate": false,
      "can_modify_code": false,
      "can_modify_specs": false,
      "can_modify_governance": false,
      "can_commit": false,
      "can_merge": false
    }
  ]
}
